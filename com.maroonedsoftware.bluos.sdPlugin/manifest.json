{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "UUID": "com.maroonedsoftware.bluos",
    "Name": "BluOS",
    "Version": "0.1.0.0",
    "Author": "Marooned Software",
    "Description": "Control a BluOS player from your Stream Deck: what is playing with its cover art, play and pause, skip, and the volume on a key or a dial.",
    "URL": "https://github.com/maroonedsoftware/bluos",
    "SupportURL": "https://github.com/maroonedsoftware/bluos/issues",
    "Icon": "imgs/plugin/icon",
    "Category": "BluOS",
    "CategoryIcon": "imgs/plugin/category-icon",
    "CodePath": "bin/plugin.js",
    "PropertyInspectorPath": "ui/player.html",
    "SDKVersion": 3,
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "12"
        },
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "24"
    },
    "Actions": [
        {
            "UUID": "com.maroonedsoftware.bluos.now-playing",
            "Name": "Now playing",
            "Tooltip": "What the player is playing, with its cover and how far through the track it is.",
            "Icon": "imgs/actions/now-playing/icon",
            "Controllers": ["Keypad"],
            "SupportedInMultiActions": false,
            "UserTitleEnabled": false,
            "States": [
                {
                    "Image": "imgs/actions/now-playing/key",
                    "TitleAlignment": "bottom",
                    "FontSize": 9
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.transport",
            "Name": "Play or pause",
            "Tooltip": "Pauses the player while it is playing, and starts it again when it is paused.",
            "Icon": "imgs/actions/transport/icon",
            "Controllers": ["Keypad"],
            "SupportedInMultiActions": false,
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Name": "Pause",
                    "Image": "imgs/actions/transport/pause",
                    "TitleAlignment": "bottom"
                },
                {
                    "Name": "Play",
                    "Image": "imgs/actions/transport/play",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.next",
            "Name": "Next track",
            "Tooltip": "Plays the next track in the queue. Radio streams have no next track.",
            "Icon": "imgs/actions/next/icon",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/next/key",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.previous",
            "Name": "Previous track",
            "Tooltip": "Plays the previous track in the queue. Radio streams have no previous track.",
            "Icon": "imgs/actions/previous/icon",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/previous/key",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.preset",
            "Name": "Preset",
            "Tooltip": "Plays one of the player's presets, with its own name and artwork, or steps to the next or previous one.",
            "Icon": "imgs/actions/preset/icon",
            "Controllers": ["Keypad"],
            "UserTitleEnabled": false,
            "States": [
                {
                    "Image": "imgs/actions/preset/key",
                    "TitleAlignment": "bottom",
                    "FontSize": 9
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.input",
            "Name": "Input",
            "Tooltip": "Switches the player to one of its inputs, such as optical, HDMI or a turntable, and shows when that input is playing.",
            "Icon": "imgs/actions/input/icon",
            "Controllers": ["Keypad"],
            "UserTitleEnabled": false,
            "States": [
                {
                    "Image": "imgs/actions/input/key",
                    "TitleAlignment": "bottom",
                    "FontSize": 9
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.shuffle",
            "Name": "Shuffle",
            "Tooltip": "Turns shuffle on or off for the player's queue.",
            "Icon": "imgs/actions/shuffle/icon",
            "Controllers": ["Keypad"],
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Name": "Off",
                    "Image": "imgs/actions/shuffle/off",
                    "TitleAlignment": "bottom"
                },
                {
                    "Name": "On",
                    "Image": "imgs/actions/shuffle/on",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.repeat",
            "Name": "Repeat",
            "Tooltip": "Steps through repeating the whole queue, one track, and off.",
            "Icon": "imgs/actions/repeat/icon",
            "Controllers": ["Keypad"],
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Name": "Queue",
                    "Image": "imgs/actions/repeat/queue",
                    "TitleAlignment": "bottom"
                },
                {
                    "Name": "Track",
                    "Image": "imgs/actions/repeat/track",
                    "TitleAlignment": "bottom"
                },
                {
                    "Name": "Off",
                    "Image": "imgs/actions/repeat/off",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.love",
            "Name": "Love",
            "Tooltip": "Marks the playing track as liked, on a streaming station that offers it.",
            "Icon": "imgs/actions/love/icon",
            "Controllers": ["Keypad"],
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Name": "Love",
                    "Image": "imgs/actions/love/key",
                    "TitleAlignment": "bottom"
                },
                {
                    "Name": "Unavailable",
                    "Image": "imgs/actions/love/unavailable",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.stop",
            "Name": "Stop",
            "Tooltip": "Stops the player. It goes into standby on its own a few minutes later, and wakes when anything asks it to play.",
            "Icon": "imgs/actions/stop/icon",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/stop/key",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.sleep",
            "Name": "Sleep timer",
            "Tooltip": "Each press moves the player's sleep timer on a step, and shows the minutes left.",
            "Icon": "imgs/actions/sleep/icon",
            "Controllers": ["Keypad"],
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Name": "Off",
                    "Image": "imgs/actions/sleep/off",
                    "TitleAlignment": "bottom"
                },
                {
                    "Name": "On",
                    "Image": "imgs/actions/sleep/on",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.volume",
            "Name": "Volume",
            "Tooltip": "Turns the player up or down, or mutes it. Which one is a setting on the key.",
            "Icon": "imgs/actions/volume/icon",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/volume/key",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.strip",
            "Name": "Now playing strip",
            "Tooltip": "Put it on all four dials: the cover, the track, the player and the time across the whole touch strip. Turn to skip, press to play or pause.",
            "Icon": "imgs/actions/strip/icon",
            "Controllers": ["Encoder"],
            "SupportedInMultiActions": false,
            "Encoder": {
                "layout": "layouts/strip.json",
                "TriggerDescription": {
                    "Rotate": "Skip",
                    "Push": "Play or pause",
                    "Touch": "Play or pause"
                }
            },
            "States": [
                {
                    "Image": "imgs/actions/strip/key"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.volume-dial",
            "Name": "Volume dial",
            "Tooltip": "Turn for the volume, press to mute, tap the strip to play or pause.",
            "Icon": "imgs/actions/volume-dial/icon",
            "Controllers": ["Encoder"],
            "SupportedInMultiActions": false,
            "Encoder": {
                "layout": "layouts/volume.json",
                "TriggerDescription": {
                    "Rotate": "Volume",
                    "Push": "Mute",
                    "Touch": "Play or pause"
                }
            },
            "States": [
                {
                    "Image": "imgs/actions/volume-dial/key"
                }
            ]
        }
    ]
}
