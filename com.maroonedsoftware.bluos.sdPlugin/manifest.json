{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "UUID": "com.maroonedsoftware.bluos",
    "Name": "BluOS",
    "Version": "0.1.0.0",
    "Author": "Marooned Software",
    "Description": "Control a BluOS player from your Stream Deck: what is playing with its cover art, play and pause, skip, and the volume on a key or a dial.",
    "URL": "https://github.com/robert-dean/bluos",
    "SupportURL": "https://github.com/robert-dean/bluos/issues",
    "Icon": "imgs/plugin/icon",
    "Category": "BluOS",
    "CategoryIcon": "imgs/plugin/category-icon",
    "CodePath": "bin/plugin.js",
    "PropertyInspectorPath": "ui/player.html",
    "SDKVersion": 3,
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "12"
        },
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "24"
    },
    "Actions": [
        {
            "UUID": "com.maroonedsoftware.bluos.now-playing",
            "Name": "Now playing",
            "Tooltip": "What the player is playing, with its cover and how far through the track it is.",
            "Icon": "imgs/actions/now-playing/icon",
            "Controllers": ["Keypad"],
            "SupportedInMultiActions": false,
            "UserTitleEnabled": false,
            "States": [
                {
                    "Image": "imgs/actions/now-playing/key",
                    "TitleAlignment": "bottom",
                    "FontSize": 9
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.transport",
            "Name": "Play or pause",
            "Tooltip": "Pauses the player while it is playing, and starts it again when it is paused.",
            "Icon": "imgs/actions/transport/icon",
            "Controllers": ["Keypad"],
            "SupportedInMultiActions": false,
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Name": "Pause",
                    "Image": "imgs/actions/transport/pause",
                    "TitleAlignment": "bottom"
                },
                {
                    "Name": "Play",
                    "Image": "imgs/actions/transport/play",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.next",
            "Name": "Next track",
            "Tooltip": "Plays the next track in the queue. Radio streams have no next track.",
            "Icon": "imgs/actions/next/icon",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/next/key",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.previous",
            "Name": "Previous track",
            "Tooltip": "Plays the previous track in the queue. Radio streams have no previous track.",
            "Icon": "imgs/actions/previous/icon",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/previous/key",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.volume",
            "Name": "Volume",
            "Tooltip": "Turns the player up or down, or mutes it. Which one is a setting on the key.",
            "Icon": "imgs/actions/volume/icon",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/volume/key",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "UUID": "com.maroonedsoftware.bluos.volume-dial",
            "Name": "Volume dial",
            "Tooltip": "Turn for the volume, press to mute, tap the strip to play or pause.",
            "Icon": "imgs/actions/volume-dial/icon",
            "Controllers": ["Encoder"],
            "SupportedInMultiActions": false,
            "Encoder": {
                "layout": "layouts/volume.json",
                "TriggerDescription": {
                    "Rotate": "Volume",
                    "Push": "Mute",
                    "Touch": "Play or pause"
                }
            },
            "States": [
                {
                    "Image": "imgs/actions/volume-dial/key"
                }
            ]
        }
    ]
}
